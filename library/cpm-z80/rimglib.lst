  117 0068' 2A 00B8'    	LD	HL, (INP_DE)	; HL = sector number
  118 006B' 44          	LD	B, H		; BC = sector number
  119 006C' 4D          	LD	C, L
  120                   
  121 006D' 21 0021     	LD	HL, 33		; HL = offset
  122 0070' 19          	ADD	HL, DE		; HL = FCB address + 33
  123 0071' 79          	LD	A, C		; A = low byte of sector number
  124 0072' 77          	LD      (HL), A		; store in FCB
  125 0073' 23          	INC	HL		; HL = FCB address + 34
  126 0074' 78          	LD      A, B		; A = high byte of sector number
  127 0075' 77          	LD      (HL), A		; store in FCB
  128 0076' 23          	INC	HL		; HL = FCB address + 35
  129 0077' AF          	XOR     A		; A = 0
  130 0078' 77          	LD      (HL), A		; store in FCB
  131                   
  132 0079' 0E 21       	LD	C, 21h		; read random
  133 007B' ED 5B 00BE' 	LD	DE, (FCBADD)	; DE = FCB address
  134 007F' CD 0005     	CALL	BDOS		; call BDOS
  135                   
  136 0082' B7          	OR	A		; set flags
  137 0083' 20 07       	JR	NZ, STRDER	; file read error
  138                   
  139 0085' AF          	XOR	A		; A = 0, CF = 0
  140                   
  141 0086' 2A 00BC'    STRDDN:	LD	HL, (BUFADD)	; HL = buffer address
  142 0089' D1          	POP	DE		; restore input DE for caller
  143 008A' C1          	POP	BC		; restore input BC for caller
  144 008B' C9          	RET
  145                   
  146 008C' 3E 05       STRDER:	LD	A, 05h		; A = 5, error code
  147 008E' 37          	SCF			; CF = 1
  148 008F' 18 F5       	JR	STRDDN
  149                   
  150                   ; ---- CLEANUP MODULE --------------------------------------------------
  151                   
  152                   ;|name   |A  |B      |C     |DE      |HL     |function|ret. A |ret. HL |
  153                   ;|-------|:-:|:-----:|:----:|:------:|:-----:|--------|:-----:|:-------|
  154                   ;|rimglib|02h|onlyfcl|      |        |       |RIDONE  |       |        |
  155                   
  156 0091' 3A 00B7'    RIDONE: LD	A, (INP_B)	; get input B data	
  157 0094' B7          	OR	A
  158 0095' 20 08       	JR	NZ, DONECL	; if A = 1 then goto INITCL
  159                   
  160 0097' 0E 1A       	LD	C, 1Ah		; set DMA address
  161 0099' 11 0080     	LD	DE, 0080h	; DE = default DMA address
  162 009C' CD 0005     	CALL	BDOS		; call BDOS
  163                   
  164 009F' 0E 10       DONECL:	LD	C, 10h		; close file
  165 00A1' ED 5B 00BE' 	LD	DE, (FCBADD)	; DE = FCB address
  166 00A5' CD 0005     	CALL	BDOS		; call BDOS
  167 00A8' 3C          	INC	A		; check result (at error: FFh -> 00h)
  168 00A9' 28 07       	JR	Z, DONEER	; at error go INITER
  169 00AB' AF          	XOR	A		; A = 0, CF = 0
  170                   
  171 00AC' 2A 00BC'    DONEDN: LD	HL, (BUFADD)	; HL = buffer address
  172 00AF' D1          	POP	DE		; restore input DE for caller
  173 00B0' C1          	POP	BC		; restore input BC for caller
  174 00B1' C9          	RET
