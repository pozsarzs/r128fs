  175 00AC' 2A 00BC'    DONEDN: LD	HL, (BUFADD)	; HL = buffer address
  176 00AF' D1          	POP	DE		; restore input DE for caller
  177 00B0' C1          	POP	BC		; restore input BC for caller
  178 00B1' C9          	RET
  179                   
  180 00B2' 3E 06       DONEER:	LD	A, 06h		; A = 6, error code
  181 00B4' 37          	SCF			; CF = 1
  182 00B5' 18 F5       	JR	DONEDN		; go DONEDN
  183                   
  184                   ; -------- DATA AREA --------
  185 00B7' 00          INP_B:	DB	0		; input data in B
  186 00B8' 0000        INP_DE:	DW	0		; input data in DE
  187 00BA' 0000        INP_HL:	DW	0		; input data in HL
  188 00BC' 0000        BUFADD:	DW	0		; buffer start address
  189 00BE' 0000        FCBADD:	DW	0		; FCB start address
  190                   	END
