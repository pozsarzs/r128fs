   59 001C' 23          	INC	HL
   60 001D' 56          	LD	D, (HL)		; load high byte
   61 001E' EB          	EX	DE, HL		; HL = handler address
   62 001F' E9          	JP	(HL)		; indirect jump to selected routine
   63                   
   64 0020' 002F'       MNJTAB:	DW	RIINIT		; 0: initialize module and/or open image file
   65 0022' 0064'       	DW	RISTRD		; 1: read a logical sector from image and write to buffer
   66 0024' 0091'       	DW	RIDONE		; 2: clean up and/or close image file
   67                   
   68 0026' D1          MNBADF:	POP	DE		; restore input DE for caller
   69 0027' C1          	POP	BC		; restore input BC for caller
   70 0028' 3E 01       	LD	A, 01h		; A = 1 (error: bad function)
   71 002A' 21 0000     	LD	HL, 0000h	; HL = 0
   72 002D' 37          	SCF			; CF = 1 (return with error)
   73 002E' C9          	RET
   74                   
   75                   ; ---- INITIALIZE MODULE -----------------------------------------------
   76                   
   77                   ;|name   |A  |B      |C     |DE      |HL     |function|ret. A |ret. HL |
   78                   ;|-------|:-:|:-----:|:----:|:------:|:-----:|--------|:-----:|:-------|
   79                   ;|rimglib|00h|onlyfop|      |fcbaddr |bufaddr|RIINIT  |errcode|bufaddr |
   80                   
   81 002F' 3A 00B7'    RIINIT: LD	A, (INP_B)	; get input B data	
   82 0032' B7          	OR	A
   83 0033' 20 17       	JR	NZ, INITOP	; if A = 1 then goto INITOP
   84                   
   85 0035' ED 5B 00B8' 	LD	DE, (INP_DE)	; get input DE data	
   86 0039' ED 53 00BE' 	LD	(FCBADD), DE	; store FCB starting address
   87 003D' 2A 00BA'    	LD	HL, (INP_HL)	; get input HL data	
   88 0040' 22 00BC'    	LD	(BUFADD), HL	; store buffer starting address
   89                   
   90 0043' 0E 1A       	LD	C, 1Ah		; set DMA address
   91 0045' ED 5B 00BC' 	LD	DE, (BUFADD)	; DE = DMA address
   92 0049' CD 0005     	CALL	BDOS		; call BDOS
   93                   
   94 004C' 0E 0F       INITOP:	LD	C, 0Fh		; open file
   95 004E' ED 5B 00BE' 	LD	DE, (FCBADD)	; DE = FCB address
   96 0052' CD 0005     	CALL	BDOS		; call BDOS
   97 0055' 3C          	INC	A		; check result (at error: FFh -> 00h)
   98 0056' 28 07       	JR	Z, INITER	; at error go INITER
   99 0058' AF          	XOR	A		; A = 0, CF = 0
  100                   
  101 0059' 2A 00BC'    INITDN: LD	HL, (BUFADD)	; HL = buffer address
  102 005C' D1          	POP	DE		; restore input DE for caller
  103 005D' C1          	POP	BC		; restore input BC for caller
  104 005E' C9          	RET
  105                   
  106 005F' 3E 04       INITER:	LD	A, 04h		; A = 4, error code
  107 0061' 37          	SCF			; CF = 1
  108 0062' 18 F5       	JR	INITDN		; go INITDN
  109                   
  110                   ; ---- READ A LOGICAL SECTOR -------------------------------------------
  111                   
  112                   ;|name   |A  |B      |C     |DE      |HL     |function|ret. A |ret. HL |
  113                   ;|-------|:-:|:-----:|:----:|:------:|:-----:|--------|:-----:|:-------|
  114                   ;|rimglib|01h|       |      |sectnum |       |RISTRD  |errcode|bufaddr |
  115                   
  116 0064' ED 5B 00BE' RISTRD:	LD	DE, (FCBADD)	; DE = FCB address
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
