   14                   PUBLIC RIMG
   15                   
   16                   ; -------- CONSTANTS --------
   17         0005      BDOS	EQU	05h			; BDOS system call
   18         0003      RNUM	EQU	03h			; Number of routines
   19                   
   20                   ; -------- CODE AREA --------
   21                   
   22                   ;|name   |A  |B      |C     |DE      |HL     |function|ret. A |ret. HL |
   23                   ;|-------|:-:|:-----:|:----:|:------:|:-----:|--------|:-----:|:-------|
   24                   ;|rimglib|00h|onlyfop|      |fcbaddr |bufaddr|RIINIT  |errcode|bufaddr |
   25                   ;|rimglib|01h|       |      |sectnum |       |RISTRD  |errcode|bufaddr |
   26                   ;|rimglib|02h|onlyfcl|      |        |       |RIDONE  |       |        |
   27                   ;
   28                   ; Error codes:
   29                   ;   00h. no error		CF = 0
   30                   ;   01h: bad function		CF = 1
   31                   ;   04h: file open error	CF = 1
   32                   ;   05h: file read error	CF = 1
   33                   ;   06h: file close error	CF = 1
   34                   ;
   35                   ; Preserves: BC, DE
   36                   ; Clobbers:  AF, HL
   37                   
   38                   ; ---- ENTRY POINT AND JUMP TABLE ----
   39 0000' C5          RIMG:	PUSH	BC		; save input BC for caller
   40 0001' D5          	PUSH	DE		; save input DE for caller
   41                   
   42 0002' 22 00BA'    	LD	(INP_HL), HL	; save input HL for selected routine 
   43 0005' ED 53 00B8' 	LD	(INP_DE), DE	; save input DE for selected routine
   44 0009' 4F          	LD	C, A
   45 000A' 78          	LD	A, B
   46 000B' 32 00B7'    	LD	(INP_B), A	; save input B for selected routine
   47 000E' 79          	LD	A, C
   48                   
   49 000F' FE 03       	CP	RNUM		; compare A (function code) with max valid index
   50 0011' 30 13       	JR	NC, MNBADF	; if A >= RNUM: invalid function, jump to MNBADF
   51                   
   52 0013' 87          	ADD	A, A		; A = A * 2 (word index into jump table)
   53 0014' 6F          	LD	L, A
   54 0015' 26 00       	LD	H, 0		; HL = zero-extended offset
   55 0017' 11 0020'    	LD	DE, MNJTAB	; DE = address of jump table entry
   56 001A' 19          	ADD	HL, DE		; HL = address of table + offset
   57                   
   58 001B' 5E          	LD	E, (HL)		; load low byte of handler address
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
