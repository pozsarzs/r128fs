	ORG	100h
	EXTRN	RMEM

; -------- CONSTANTS --------
BDOS	EQU	0005h		; BDOS entry
PRINT	EQU	09h		; BDOS print function

; -------- CODE AREA --------
START:
; initialization
	LD	A, 00h		; RMINIT
	LD	DE, ROMIMG
	LD	HL, BUFFER
	CALL	RMEM
	JR	C, INITER

; read sector 0
	LD	A, 01h		; RMSTRD
	LD	DE, 0000h
	CALL	RMEM
	JR	C, READER

; print buffer
	LD	DE, BUFFER
	LD	C, PRINT
	CALL	BDOS
	JR	EXIT

; handling error
INITER:	LD	DE, MSGINI	; init error
	JR	PRNER

READER:	LD	DE, MSGRED	; read error

PRNER:	LD	C, PRINT	; print error message
	CALL	BDOS

EXIT:	RET

; -------- DATA AREA --------
ROMIMG:	DB	'RMEMLIB TEST OK',13,10,'$'
MSGINI:	DB	'INIT ERROR$', 0
MSGRED:	DB	'READ ERROR$', 0
BUFFER:	DS	128
