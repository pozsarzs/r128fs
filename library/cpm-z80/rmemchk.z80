	ORG	100h
	EXTRN	RMEM

; **** CONSTANTS ****
BDOS	EQU	0005h		; BDOS entry point
BRESET	EQU	00h		; - system reset function
BPRINT	EQU	09h		; - print string function
RMINIT	EQU	00h		; Rmemlib initialize function
RMSTRD	EQU	01h		; Rmemlib sector read function

; **** CODE AREA ****
START:	LD	A, RMINIT	; A = initialization
	LD	DE, ROMIMG	; DE = ROMIMG address
	LD	HL, BUFFER	; HL = BUFFER address
	CALL	RMEM		; call RMEM
	JR	C, INITER	; detect init error

	LD	A, RMSTRD	; A = read sector
	LD	DE, 0000h	; DE = sector number
	CALL	RMEM		; call RMEM
	JR	C, READER	; detect read error

	LD	DE, BUFFER	; DE = buffer address
	LD	C, BPRINT	; C = print buffer 
	CALL	BDOS		; call BDOS
	JR	EXIT		; goto EXIT

INITER:	LD	DE, MSGINI	; DE = init error message
	JR	PRNER

READER:	LD	DE, MSGRED	; DE =read error message

PRNER:	LD	C, PRINT	; C = print error message
	CALL	BDOS		; call BDOS

EXIT:	LD	C, BRESET	; C = exit to BDOS
	CALL	BDOS		; call BDOS

; **** DATA AREA ****
ROMIMG:	DB	'Rmemlib test ok.',13,10,'$'
MSGINI:	DB	'Init error!$', 0
MSGRED:	DB	'Read error!$', 0
BUFFER:	DS	128
	END
