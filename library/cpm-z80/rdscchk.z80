	ORG	100h
	EXTRN	RDSC

; -------- CONSTANTS --------
BDOS	EQU	05h		; BDOS entry point
BRESET	EQU	00h		; BDOS system reset function
BCONOUT	EQU	02h		; BDOS console output function
BPRINT	EQU	09h		; BDOS print string function
RDINIT	EQU	00h		; Rdsclib initialize function
RDSTRD	EQU	01h		; Rdsclib sector read function

; -------- CODE AREA --------
START:
; initialization
	LD	A, RDINIT
	LD	HL, BUFFER
	CALL	RDSC
	JR	C, INITER

; read record
	LD	A, (DISCID)
	LD	B, A
	LD	A, RDSTRD
	LD	DE, (TRACK)
	LD	HL, (SECTOR)
	CALL	RDSC
	JR	C, READER

; dump buffer to console
	LD	HL, BUFFER
	LD	B, 128
PRLOOP:	LD	E, (HL)
	LD	C, BCONOUT
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	BDOS
	POP	HL
	POP	DE
	POP	BC
	INC	HL
	DJNZ	PRLOOP
	JR	EXIT

; handling error
INITER:	LD	DE, MSGINI	; init error
	JR	PRNER

READER:	LD	DE, MSGRED	; read error

PRNER:	LD	C, BPRINT	; print error message
	CALL	BDOS
	
EXIT:	LD	C, BRESET	; exit to BDOS
	CALL	BDOS

; -------- DATA AREA --------
DISCID:	DB	0
TRACK:	DW	1
SECTOR:	DW	1
MSGINI:	DB	'Init error!$', 0
MSGRED:	DB	'Read error!$', 0
BUFFER:	DS	128, 0
	END
