	ORG	100h
	EXTRN	RDSC

; **** CONSTANTS ****
BDOS	EQU	05h		; BDOS entry point
BRESET	EQU	00h		; - system reset function
BCONOUT	EQU	02h		; - console output function
BPRINT	EQU	09h		; - print string function
RDINIT	EQU	00h		; Rdsclib initialize function
RDSTRD	EQU	01h		; Rdsclib sector read function

; **** CODE AREA ****
START:	LD	A, RDINIT	; A = initialization
	LD	HL, BUFFER	; HL = buffer address
	CALL	RDSC		; call RDSC
	JR	C, INITER	; detect init error

	LD	A, (DISCID)	; A = disc ID
	LD	B, A
	LD	A, RDSTRD	; A = read sector
	LD	DE, (TRACK)	; DE = track number
	LD	HL, (SECTOR)	; HL = sector number
	CALL	RDSC		; call RDSC
	JR	C, READER	; detect read error

	LD	HL, BUFFER	; HL = buffer address
	LD	B, 128		; counter
PRLOOP:	LD	E, (HL)		; print buffer to console with loop
	LD	C, BCONOUT	; print to console
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	BDOS		; call BDOS
	POP	HL
	POP	DE
	POP	BC
	INC	HL
	DJNZ	PRLOOP
	JR	EXIT		; goto EXIT

INITER:	LD	DE, MSGINI	; DE = init error message
	JR	PRNER

READER:	LD	DE, MSGRED	; DE = read error message

PRNER:	LD	C, BPRINT	; DE = print error
	CALL	BDOS		; call BDOS
	
EXIT:	LD	C, BRESET	; C = exit to BDOS
	CALL	BDOS		; call BDOS

; **** DATA AREA ****
DISCID:	DB	0
TRACK:	DW	1
SECTOR:	DW	1
MSGINI:	DB	'Init error!$', 0
MSGRED:	DB	'Read error!$', 0
BUFFER:	DS	128, 0
	END
