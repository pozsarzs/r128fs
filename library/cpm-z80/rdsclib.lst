   14                   PUBLIC RDSC
   15                   
   16                   ; -------- CONSTANTS --------
   17         0005      BDOS	EQU	05h		; BDOS entry point
   18         0002      RNUM	EQU	02h		; number of routines
   19                   
   20                   ; -------- CODE AREA --------
   21                   
   22                   ;|name   |A  |B      |C    |DE      |HL     |function|ret. A |ret. HL |
   23                   ;|-------|:-:|:-----:|:---:|:------:|:-----:|--------|:-----:|:-------|
   24                   ;|rdsclib|00h|       |     |        |bufaddr|RDINIT  |0      |bufaddr |
   25                   ;|rdsclib|01h|discid |     |track   |sector |RDSTRD  |errcode|bufaddr |
   26                   ;
   27                   ; Error codes:
   28                   ;   00h. no error		CF = 0
   29                   ;   01h: bad function		CF = 1
   30                   ;   07h: sector read error	CF = 1
   31                   ;
   32                   ; Preserves: BC, DE
   33                   ; Clobbers:  AF, HL
   34                   
   35                   ; ---- ENTRY POINT AND JUMP TABLE ----
   36 0000' C5          RDSC:	PUSH	BC		; save input BC for caller
   37 0001' D5          	PUSH	DE		; save input DE for caller
   38                   
   39 0002' F5          	PUSH	AF		; save input AF
   40 0003' 22 0079'    	LD	(INP_HL), HL	; save input HL for selected routine 
   41 0006' ED 53 0077' 	LD	(INP_DE), DE	; save input DE for selected routine
   42 000A' 78          	LD	A, B
   43 000B' 32 0076'    	LD	(INP_B), A	; save input B for selected routine
   44 000E' F1          	POP	AF		; restore input AF
   45                   
   46 000F' FE 02       	CP	RNUM		; compare A (function code) with max valid index
   47 0011' 30 11       	JR	NC, MNBADF	; if A >= RNUM: invalid function, jump to MNBADF
   48                   
   49 0013' 87          	ADD	A, A		; A = A * 2 (word index into jump table)
   50 0014' 6F          	LD	L, A
   51 0015' 26 00       	LD	H, 0		; HL = zero-extended offset
   52 0017' 11 0020'    	LD	DE, MNJTAB	; DE = address of jump table entry
   53 001A' 19          	ADD	HL, DE		; HL = address of table + offset
   54                   
   55 001B' 5E          	LD	E, (HL)		; load low byte of handler address
   56 001C' 23          	INC	HL
   57 001D' 56          	LD	D, (HL)		; load high byte
   58 001E' EB          	EX	DE, HL		; HL = handler address
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
