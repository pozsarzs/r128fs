  117                   
  118 0066' B7          	OR	A, A
  119 0067' C2 006D'    	JP	NZ, STRDER	; if result > 0 then goto STRDER
  120 006A' AF          	XOR	A		; A = 0, CF = 0
  121 006B' 18 03       	JR	STRDDN		; goto STRDDN
  122                   
  123 006D' 3E 07       STRDER:	LD	A, 07h		; A = 7
  124 006F' 37          	SCF			; CF = 1
