   14                   PUBLIC RDSC
   15                   
   16                   ; **** CONSTANTS ****
   17         0005      BDOS	EQU	05h		; BDOS entry point
   18         0002      RNUM	EQU	02h		; number of routines
   19                   
   20                   ; **** CODE AREA ****
   21                   
   22                   ; ---- ENTRY POINT AND JUMP TABLE -------------------------------------
   23                   
   24                   ;|name   |A  |B      |C    |DE      |HL     |function|ret. A |ret. HL |
   25                   ;|-------|:-:|:-----:|:---:|:------:|:-----:|--------|:-----:|:-------|
   26                   ;|rdsclib|00h|       |     |        |bufaddr|RDINIT  |0      |bufaddr |
   27                   ;|rdsclib|01h|discid |     |track   |sector |RDSTRD  |errcode|bufaddr |
   28                   ;
   29                   ; Error codes:
   30                   ;   00h. no error		CF = 0
   31                   ;   01h: bad function		CF = 1
   32                   ;   07h: sector read error	CF = 1
   33                   ;
   34                   ; Preserves: BC, DE
   35                   ; Clobbers:  AF, HL
   36                   
   37 0000' C5          RDSC:	PUSH	BC		; save input BC for caller
   38 0001' D5          	PUSH	DE		; save input DE for caller
   39                   
   40 0002' F5          	PUSH	AF		; save input AF
   41 0003' 22 00A1'    	LD	(INP_HL), HL	; save input HL for selected routine 
   42 0006' ED 53 009F' 	LD	(INP_DE), DE	; save input DE for selected routine
   43 000A' 78          	LD	A, B
   44 000B' 32 009E'    	LD	(INP_B), A	; save input B for selected routine
   45 000E' F1          	POP	AF		; restore input AF
   46                   
   47 000F' FE 02       	CP	RNUM		; compare A (function code) with max valid index
   48 0011' 30 11       	JR	NC, MNBADF	; if A >= RNUM: invalid function, jump to MNBADF
   49                   
   50 0013' 87          	ADD	A, A		; A = A * 2 (word index into jump table)
   51 0014' 6F          	LD	L, A
   52 0015' 26 00       	LD	H, 0		; HL = zero-extended offset
   53 0017' 11 0020'    	LD	DE, MNJTAB	; DE = address of jump table entry
   54 001A' 19          	ADD	HL, DE		; HL = address of table + offset
   55                   
   56 001B' 5E          	LD	E, (HL)		; load low byte of handler address
   57 001C' 23          	INC	HL
   58 001D' 56          	LD	D, (HL)		; load high byte
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   2
RDSCLIB Z80

   59 001E' EB          	EX	DE, HL		; HL = handler address
   60 001F' E9          	JP	(HL)		; indirect jump to selected routine
   61                   
   62 0020' 002D'       MNJTAB:	DW	RDINIT		; 0: initialize module and/or open image file
   63 0022' 0044'       	DW	RDSTRD		; 1: read a logical sector from image and write to buffer
   64                   
   65 0024' D1          MNBADF:	POP	DE		; restore input DE for caller
   66 0025' C1          	POP	BC		; restore input BC for caller
   67 0026' 3E 01       	LD	A, 01h		; A = 1 (error: bad function)
   68 0028' 21 0000     	LD	HL, 0000h	; HL = 0
   69 002B' 37          	SCF			; CF = 1 (return with error)
   70 002C' C9          	RET
   71                   
   72                   ; ---- INITIALIZE MODULE ----------------------------------------------
   73                   
   74                   ;|name   |A  |B      |C    |DE      |HL     |function|ret. A |ret. HL |
   75                   ;|-------|:-:|:-----:|:---:|:------:|:-----:|--------|:-----:|:-------|
   76                   ;|rdsclib|00h|       |     |        |bufaddr|RDINIT  |0      |bufaddr |
   77                   
   78 002D' 2A 00A1'    RDINIT:	LD	HL, (INP_HL)	; get input HL data	
   79 0030' 22 00A3'    	LD	(BUFADD), HL	; store buffer starting address
   80                   
   81 0033' 2A 0001     	LD	HL, (0001h)	; HL = BIOS Warm Boot (WBOOT) pointer
   82 0036' 11 FFFD     	LD	DE, -3		; DE = -3 (0000-0002h: JP nnnn)
   83 0039' 19          	ADD	HL, DE		; HL = HL - 3
   84 003A' 22 00A5'    	LD	(BFJTAB), HL	; (BFJTAB) = HL, BIOS jump table base address
   85                   
   86 003D' AF          INITDN: XOR	A		; A = 0, CF = 0
   87 003E' 2A 00A3'    	LD	HL, (BUFADD)	; HL = buffer address
   88 0041' D1          	POP	DE		; restore input DE for caller
   89 0042' C1          	POP	BC		; restore input BC for caller
   90 0043' C9          	RET
   91                   
   92                   ; ---- READ A SECTOR --------------------------------------------------
   93                   
   94                   ;|name   |A  |B      |C    |DE      |HL     |function|ret. A |ret. HL |
   95                   ;|-------|:-:|:-----:|:---:|:------:|:-----:|--------|:-----:|:-------|
   96                   ;|rdsclib|01h|discid |     |track   |sector |RDSTRD  |errcode|bufaddr |
   97                   
   98 0044' 3A 009E'    RDSTRD:	LD	A, (INP_B)	; get input B data
   99 0047' 4F          	LD	C, A
  100 0048' CD 0076'    	CALL	BSLDSK		; select disc
  101                   
  102 004B' 2A 009F'    	LD	HL, (INP_DE)	; get input DE data
  103 004E' 44          	LD	B, H
  104 004F' 4D          	LD	C, L
  105 0050' CD 007E'    	CALL	BSTRCK		; select track
  106                   
  107 0053' 2A 00A1'    	LD	HL, (INP_HL)	; get input HL data
  108 0056' 44          	LD	B, H
  109 0057' 4D          	LD	C, L
  110 0058' CD 0086'    	CALL	BSSECT		; select sector
  111                   
  112 005B' 2A 00A3'    	LD	HL, (BUFADD)
  113 005E' 44          	LD	B, H
  114 005F' 4D          	LD	C, L
  115 0060' CD 008E'    	CALL	BSDMA		; set DMA buffer address
  116                   
Z80ASM SuperFast Relocating Macro Assembler     	    Z80ASM 1.32 Page   3
