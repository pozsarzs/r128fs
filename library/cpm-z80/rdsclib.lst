  141 0087' 2A 007D'    BSTRCK:	LD	HL, (BFJTAB)
  142 008A' 11 001E     	LD	DE, 30
  143 008D' 19          	ADD	HL, DE
  144 008E' E9          	JP	(HL)		; jump to the BIOS SETTRK routine
  145 008F' 2A 007D'    BSSECT:	LD	HL, (BFJTAB)
  146 0092' 11 0021     	LD	DE, 33
  147 0095' 19          	ADD	HL, DE
  148 0096' E9          	JP	(HL)		; jump to the BIOS SETSEC routine
  149 0097' 2A 007D'    BSDMA:	LD	HL, (BFJTAB)
  150 009A' 11 0024     	LD	DE, 36
  151 009D' 19          	ADD	HL, DE
  152 009E' E9          	JP	(HL)		; jump to the BIOS SETDMA routine
  153 009F' 2A 007D'    BREAD:	LD	HL, (BFJTAB)
  154 00A2' 11 0027     	LD	DE, 39
