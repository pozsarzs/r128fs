  126 0070' 2A 007B'    STRDDN:	LD	HL, (BUFADD)	; HL = buffer address
  127 0073' D1          	POP	DE		; restore input DE for caller
  128 0074' C1          	POP	BC		; restore input BC for caller
  129 0075' C9          	RET
  130                   
  131                   ; -------- DATA AREA --------
  132 0076' 00          INP_B:	DB	0		; input data in B
  133 0077' 0000        INP_DE:	DW	0		; input data in DE
  134 0079' 0000        INP_HL:	DW	0		; input data in HL
  135 007B' 0000        BUFADD:	DW	0		; buffer start address
  136 007D' 0000        BFJTAB:	DW	0		; BIOS functions jump table base address
  137 007F' 2A 007D'    BSLDSK:	LD	HL, (BFJTAB)
  138 0082' 11 001B     	LD	DE, 27
  139 0085' 19          	ADD	HL, DE
