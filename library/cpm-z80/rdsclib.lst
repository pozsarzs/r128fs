   59 001F' E9          	JP	(HL)		; indirect jump to selected routine
   60                   
   61 0020' 002D'       MNJTAB:	DW	RDINIT		; 0: initialize module and/or open image file
   62 0022' 0044'       	DW	RDSTRD		; 1: read a logical sector from image and write to buffer
   63                   
   64 0024' D1          MNBADF:	POP	DE		; restore input DE for caller
   65 0025' C1          	POP	BC		; restore input BC for caller
   66 0026' 3E 01       	LD	A, 01h		; A = 1 (error: bad function)
   67 0028' 21 0000     	LD	HL, 0000h	; HL = 0
   68 002B' 37          	SCF			; CF = 1 (return with error)
   69 002C' C9          	RET
   70                   
   71                   ; ---- INITIALIZE MODULE ----------------------------------------------
   72                   
   73                   ;|name   |A  |B      |C    |DE      |HL     |function|ret. A |ret. HL |
   74                   ;|-------|:-:|:-----:|:---:|:------:|:-----:|--------|:-----:|:-------|
   75                   ;|rdsclib|00h|       |     |        |bufaddr|RDINIT  |0      |bufaddr |
   76                   
   77 002D' 2A 0079'    RDINIT:	LD	HL, (INP_HL)	; get input HL data	
   78 0030' 22 007B'    	LD	(BUFADD), HL	; store buffer starting address
   79                   
   80 0033' 2A 0001     	LD	HL, (0001h)	; HL = BIOS Warm Boot (WBOOT) pointer
   81 0036' 11 FFFD     	LD	DE, -3		; DE = -3 (0000-0002h: JP nnnn)
   82 0039' 19          	ADD	HL, DE		; HL = HL - 3
   83 003A' 22 007D'    	LD	(BFJTAB), HL	; (BFJTAB) = HL, BIOS jump table base address
   84                   
   85 003D' AF          INITDN: XOR	A		; A = 0, CF = 0
   86 003E' 2A 007B'    	LD	HL, (BUFADD)	; HL = buffer address
   87 0041' D1          	POP	DE		; restore input DE for caller
   88 0042' C1          	POP	BC		; restore input BC for caller
   89 0043' C9          	RET
   90                   
   91                   ; ---- READ A LOGICAL SECTOR ------------------------------------------
   92                   
   93                   ;|name   |A  |B      |C    |DE      |HL     |function|ret. A |ret. HL |
   94                   ;|-------|:-:|:-----:|:---:|:------:|:-----:|--------|:-----:|:-------|
   95                   ;|rdsclib|01h|discid |     |track   |sector |RDSTRD  |errcode|bufaddr |
   96                   
   97 0044' 3A 0076'    RDSTRD:	LD	A, (INP_B)	; get input B data
   98 0047' 4F          	LD	C, A
   99 0048' CD 007F'    	CALL	BSLDSK		; select disc
  100                   
  101 004B' 2A 0077'    	LD	HL, (INP_DE)	; get input DE data
  102 004E' 44          	LD	B, H
  103 004F' 4D          	LD	C, L
  104 0050' CD 0087'    	CALL	BSTRCK		; select track
  105                   
  106 0053' 2A 0079'    	LD	HL, (INP_HL)	; get input HL data
  107 0056' 44          	LD	B, H
  108 0057' 4D          	LD	C, L
  109 0058' CD 008F'    	CALL	BSSECT		; select sector
  110                   
  111 005B' 2A 007B'    	LD	HL, (BUFADD)
  112 005E' 44          	LD	B, H
  113 005F' 4D          	LD	C, L
  114 0060' CD 0097'    	CALL	BSDMA		; set DMA buffer address
  115                   
  116 0063' CD 009F'    	CALL	BREAD		; read disc
