  117 0063' CD 0096'    	CALL	BREAD		; read disc
  118                   
  119 0066' B7          	OR	A, A
  120 0067' C2 006D'    	JP	NZ, STRDER	; if result > 0 then goto STRDER
  121 006A' AF          	XOR	A		; A = 0, CF = 0
  122 006B' 18 03       	JR	STRDDN		; goto STRDDN
  123                   
  124 006D' 3E 07       STRDER:	LD	A, 07h		; A = 7
  125 006F' 37          	SCF			; CF = 1
  126                   	
  127 0070' 2A 00A3'    STRDDN:	LD	HL, (BUFADD)	; HL = buffer address
  128 0073' D1          	POP	DE		; restore input DE for caller
  129 0074' C1          	POP	BC		; restore input BC for caller
  130 0075' C9          	RET
  131                   
  132                   ; ---- BIOS FUNCTION JUMP TABLE ---------------------------------
  133 0076' 2A 00A5'    BSLDSK:	LD	HL, (BFJTAB)
  134 0079' 11 001B     	LD	DE, 27
  135 007C' 19          	ADD	HL, DE
  136 007D' E9          	JP	(HL)		; jump to the BIOS SELDSK routine
  137 007E' 2A 00A5'    BSTRCK:	LD	HL, (BFJTAB)
  138 0081' 11 001E     	LD	DE, 30
  139 0084' 19          	ADD	HL, DE
  140 0085' E9          	JP	(HL)		; jump to the BIOS SETTRK routine
  141 0086' 2A 00A5'    BSSECT:	LD	HL, (BFJTAB)
  142 0089' 11 0021     	LD	DE, 33
  143 008C' 19          	ADD	HL, DE
  144 008D' E9          	JP	(HL)		; jump to the BIOS SETSEC routine
  145 008E' 2A 00A5'    BSDMA:	LD	HL, (BFJTAB)
  146 0091' 11 0024     	LD	DE, 36
  147 0094' 19          	ADD	HL, DE
  148 0095' E9          	JP	(HL)		; jump to the BIOS SETDMA routine
  149 0096' 2A 00A5'    BREAD:	LD	HL, (BFJTAB)
  150 0099' 11 0027     	LD	DE, 39
  151 009C' 19          	ADD	HL, DE
  152 009D' E9          	JP	(HL)		; jump to the BIOS READ routine
  153                   
  154                   ; **** DATA AREA ****
  155 009E' 00          INP_B:	DB	0		; input data in B
  156 009F' 0000        INP_DE:	DW	0		; input data in DE
  157 00A1' 0000        INP_HL:	DW	0		; input data in HL
  158 00A3' 0000        BUFADD:	DW	0		; buffer start address
  159 00A5' 0000        BFJTAB:	DW	0		; BIOS functions jump table base address
