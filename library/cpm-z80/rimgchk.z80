	ORG	100h
	EXTRN	RIMG

; **** CONSTANTS ****
BDOS	EQU	05h		; BDOS entry point
BRESET	EQU	00h		; - system reset function
BCONOUT	EQU	02h		; - console output function
BPRINT	EQU	09h		; - print string function
RIINIT	EQU	00h		; Rimglib initialize function
RISTRD	EQU	01h		; Rimglib sector read function
RIDONE	EQU	02h		; Rimglib done function

; **** CODE AREA ****
START:	LD	A, RIINIT	; A = initialization and open
	LD	B, 0		; B = mode
	LD	DE, FCB		; DE = FCB address
	LD	HL, BUFFER	; HL = buffer address
	CALL	RIMG		; call RIMG
	JR	C, INITERR	; detect init error

	LD	A, RISTRD	; A = read a sector
	LD	DE, (RECNUM)	; DE = sector number
	CALL	RIMG		; call RIMG
	JR	C, READERR	; detect read error

	LD	HL, BUFFER	; print buffer to console with loop
	LD	B, 128		; counter
PRLOOP:	LD	E, (HL)		; E = buffer address
	LD	C, BCONOUT	; C = print to console
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	BDOS		; call BDOS
	POP	HL
	POP	DE
	POP	BC
	INC	HL
	DJNZ	PRLOOP

DONE:	LD	A, RIDONE	; A = close and cleanup
	LD	B, 0		; B = mode
	CALL	RIMG		; call RIMG
	JR	EXIT		; goto EXIT

INITER:	LD	DE, MSGINI	; DE = init error message
	JR	PRNER

READER:	LD	DE, MSGRED	; DE = read error message

PRNER:	LD	C, PRINT	; C = print error message
	CALL	BDOS		; call BDOS

EXIT:	LD	C, BRESET	; C = exit to BDOS
	CALL	BDOS		; call BDOS

; **** DATA AREA ****
RECNUM:	DW	0001h		; logical 128-byte record number
MSGINI:	DB	'Init error!$'
MSGRED:	DB	'Read error!$'
FCB:	DB	0		; drive
	DB	'R128EXRMIMG'	; 8.3 filename
	DS	25, 0
BUFFER:	DS	128, 0
	END
