	ORG	100h
	EXTRN	RIMG

; -------- CONSTANTS --------
BDOS	EQU	0005h		; BDOS entry
CONOUT	EQU	02h		; BDOS console output
RIINIT	EQU	00h		; rimglib functions
RISTRD	EQU	01h
RIDONE	EQU	02h

; -------- CODE AREA --------
START:
; initialization and open
	LD	A, RIINIT
	LD	B, 0
	LD	DE, FCB
	LD	HL, BUFFER
	CALL	RIMG
	JR	C, ERROR

; read record
	LD	A, RISTRD
	LD	DE, (RECNUM)
	CALL	RIMG
	JR	C, ERROR

; dump buffer to console
	LD	HL, BUFFER
	LD	B, 128
PRLOOP:	LD	E, (HL)
	LD	C, CONOUT
	PUSH	BC
	PUSH	DE
	PUSH	HL
	CALL	BDOS
	POP	HL
	POP	DE
	POP	BC
	INC	HL
	DJNZ	PRLOOP

; close and cleanup
DONE:	LD	A, RIDONE
	LD	B, 0
	CALL	RIMG
	RET

; handling error
ERROR:	LD	HL, ERRMSG
	LD	C, 09h
	EX	DE, HL
	CALL	BDOS
	RET

; -------- DATA AREA --------
RECNUM:	DW	0001h		; logical 128-byte record number
ERRMSG:	DB	'Read error!$'
FCB:	DB	0		; drive
	DB	'R128EXRMIMG'	; 8.3 filename
	DS	25, 0
BUFFER:	DS	128, 0
	END
