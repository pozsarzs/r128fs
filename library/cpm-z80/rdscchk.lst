   14         0100      	ORG	100h
   15                   	EXTRN	RDSC
   16                   
   17                   ; -------- CONSTANTS --------
   18         0005      BDOS	EQU	05h		; BDOS entry point
   19         0000      BRESET	EQU	00h		; BDOS system reset function
   20         0002      BCONOUT	EQU	02h		; BDOS console output function
   21         0009      BPRINT	EQU	09h		; BDOS print string function
   22         0000      RDINIT	EQU	00h		; Rdsclib initialize function
   23         0001      RDSTRD	EQU	01h		; Rdsclib sector read function
   24                   
   25                   ; -------- CODE AREA --------
   26 0100              START:
   27                   ; initialization
   28 0100  3E 00       	LD	A, RDINIT
   29 0102  21 0163     	LD	HL, BUFFER
   30 0105  CD 0000#    	CALL	RDSC
   31 0108  38 28       	JR	C, INITER
   32                   
   33                   ; read record
   34 010A  3A 0144     	LD	A, (DISCID)
   35 010D  47          	LD	B, A
   36 010E  3E 01       	LD	A, RDSTRD
   37 0110  ED 5B 0145  	LD	DE, (TRACK)
   38 0114  2A 0147     	LD	HL, (SECTOR)
   39 0117  CD 0000#    	CALL	RDSC
   40 011A  38 1B       	JR	C, READER
   41                   
   42                   ; dump buffer to console
   43 011C  21 0163     	LD	HL, BUFFER
   44 011F  06 80       	LD	B, 128
   45 0121  5E          PRLOOP:	LD	E, (HL)
   46 0122  0E 02       	LD	C, BCONOUT
   47 0124  C5          	PUSH	BC
   48 0125  D5          	PUSH	DE
   49 0126  E5          	PUSH	HL
   50 0127  CD 0005     	CALL	BDOS
   51 012A  E1          	POP	HL
   52 012B  D1          	POP	DE
   53 012C  C1          	POP	BC
   54 012D  23          	INC	HL
   55 012E  10 F1       	DJNZ	PRLOOP
   56 0130  18 0D       	JR	EXIT
   57                   
   58                   ; handling error
