   59 013A  0E 09       PRNER:	LD	C, BPRINT	; DE = print error
   60 013C  CD 0005     	CALL	BDOS		; call BDOS
   61                   	
   62 013F  0E 00       EXIT:	LD	C, BRESET	; C = exit to BDOS
   63 0141  CD 0005     	CALL	BDOS		; call BDOS
   64                   
   65                   ; **** DATA AREA ****
   66 0144  00          DISCID:	DB	0
   67 0145  0001        TRACK:	DW	1
   68 0147  0001        SECTOR:	DW	1
   69 0149  49 6E 69 74 MSGINI:	DB	'Init error!$', 0
   70 0156  52 65 61 64 MSGRED:	DB	'Read error!$', 0
   71 0163  00 00 00 00 BUFFER:	DS	128, 0
   72                   	END
