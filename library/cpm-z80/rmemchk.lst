   14         0100      	ORG	100h
   15                   	EXTRN	RMEM
   16                   
   17                   ; -------- CONSTANTS --------
   18         0005      BDOS	EQU	0005h			; BDOS entry point
   19         0000      BRESET	EQU	00h			; BDOS system reset function
   20         0009      BPRINT	EQU	09h			; BDOS print string function
   21         0000      RMINIT	EQU	00h			; Rmemlib initialize function
   22         0001      RMSTRD	EQU	01h			; Rmemlib sector read function
   23                   
   24                   ; -------- CODE AREA --------
   25 0100              START:
   26                   ; initialization
   27 0100  3E 00       	LD	A, RMINIT
   28 0102  11 0133     	LD	DE, ROMIMG
   29 0105  21 015D     	LD	HL, BUFFER
   30 0108  CD 0000#    	CALL	RMEM
   31 010B  38 14       	JR	C, INITER
   32                   
   33                   ; read sector 0
   34 010D  3E 01       	LD	A, RMSTRD
   35 010F  11 0000     	LD	DE, 0000h
   36 0112  CD 0000#    	CALL	RMEM
   37 0115  38 0F       	JR	C, READER
   38                   
   39                   ; print buffer
   40 0117  11 015D     	LD	DE, BUFFER
   41 011A  0E 09       	LD	C, BPRINT
   42 011C  CD 0005     	CALL	BDOS
   43 011F  18 0D       	JR	EXIT
   44                   
   45                   ; handling error
   46 0121  11 0145     INITER:	LD	DE, MSGINI	; init error
   47 0124  18 03       	JR	PRNER
   48                   
   49 0126  11 0151     READER:	LD	DE, MSGRED	; read error
   50                   
   51 0129  0E 09       PRNER:	LD	C, BPRINT	; print error message
   52 012B  CD 0005     	CALL	BDOS
   53                   
   54 012E  0E 00       EXIT:	LD	C, BRESET	; exit to BDOS
   55 0130  CD 0005     	CALL	BDOS
   56                   
   57                   ; -------- DATA AREA --------
   58 0133  52 4D 45 4D ROMIMG:	DB	'RMEMLIB TEST OK',13,10,'$'
