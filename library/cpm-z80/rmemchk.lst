   13                   
   14         0100      	ORG	100h
   15                   	EXTRN	RMEM
   16                   
   17                   ; **** CONSTANTS ****
   18         0005      BDOS	EQU	0005h		; BDOS entry point
   19         0000      BRESET	EQU	00h		; - system reset function
   20         0009      BPRINT	EQU	09h		; - print string function
   21         0000      RMINIT	EQU	00h		; Rmemlib initialize function
   22         0001      RMSTRD	EQU	01h		; Rmemlib sector read function
   23                   
   24                   ; **** CODE AREA ****
   25 0100  3E 00       START:	LD	A, RMINIT	; A = initialization
   26 0102  11 0133     	LD	DE, ROMIMG	; DE = ROMIMG address
   27 0105  21 0160     	LD	HL, BUFFER	; HL = BUFFER address
   28 0108  CD 0000#    	CALL	RMEM		; call RMEM
   29 010B  38 14       	JR	C, INITER	; detect init error
   30                   
   31 010D  3E 01       	LD	A, RMSTRD	; A = read sector
   32 010F  11 0000     	LD	DE, 0000h	; DE = sector number
   33 0112  CD 0000#    	CALL	RMEM		; call RMEM
   34 0115  38 0F       	JR	C, READER	; detect read error
   35                   
   36 0117  11 0160     	LD	DE, BUFFER	; DE = buffer address
   37 011A  0E 09       	LD	C, BPRINT	; C = print buffer 
   38 011C  CD 0005     	CALL	BDOS		; call BDOS
   39 011F  18 0D       	JR	EXIT		; goto EXIT
   40                   
   41 0121  11 0146     INITER:	LD	DE, MSGINI	; DE = init error message
   42 0124  18 03       	JR	PRNER
   43                   
   44 0126  11 0153     READER:	LD	DE, MSGRED	; DE =read error message
   45                   
   46 0129  0E 09       PRNER:	LD	C, BPRINT	; C = print error message
   47 012B  CD 0005     	CALL	BDOS		; call BDOS
   48                   
   49 012E  0E 00       EXIT:	LD	C, BRESET	; C = exit to BDOS
   50 0130  CD 0005     	CALL	BDOS		; call BDOS
   51                   
   52                   ; **** DATA AREA ****
   53 0133  52 6D 65 6D ROMIMG:	DB	'Rmemlib test ok.',13,10,'$'
   54 0146  49 6E 69 74 MSGINI:	DB	'Init error!$', 0
   55 0153  52 65 61 64 MSGRED:	DB	'Read error!$', 0
   56 0160    0080      BUFFER:	DS	128
   57                   	END
