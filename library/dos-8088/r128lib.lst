 0020  0037 R	 	 	 	DW	R128FN	 	; 2: find next
 0022  0038 R	 	 	 	DW	R128OP	 	; 3: open file
 0024  0039 R	 	 	 	DW	R128RD	 	; 4: read file
 0026  003A R	 	 	 	DW	R128SK	 	; 5: seek in fi
	 	 	 	le
 0028  003B R	 	 	 	DW	R128CL	 	; 6: close file
 002A  003C R	 	 	 	DW	R128NF	 	; 7: read media
	 	 	 	 or file information
 	 	 	 	
 002C  5F	 	 	MNBADF:	POP	DI	 	; restore input
	 	 	 	 DI for caller
 002D  5E	 	 	 	POP	SI	 	; restore input
	 	 	 	 SI for caller
 002E  59	 	 	 	POP	CX	 	; restore input
	 	 	 	 CX for caller
 002F  B0 01	 	 	 	MOV	AL, 01h	 	; AL = 1 (error
	 	 	 	: bad function)
 0031  33 DB	 	 	 	XOR	BX, BX	 	; BX = 0
 0033  F9	 	 	 	STC	 	 	; CF = 1 (retur
	 	 	 	n with error)
 0034  C3	 	 	 	RET
 	 	 	 	
