	 	 	 	8FN  |errcode|entryptr|
 	 	 	 	;|r128lib|03h|       |    |       |nameaddr|R12
	 	 	 	8OP  |errcode|        |
 	 	 	 	;|r128lib|04h|       |    |       |count   |R12
	 	 	 	8RD  |errcode|bytesrd |
 	 	 	 	;|r128lib|05h|       |    |       |pos     |R12
	 	 	 	8SK  |errcode|        |
 	 	 	 	;|r128lib|06h|       |    |       |        |R12
	 	 	 	8CL  |errcode|        |
 	 	 	 	;|r128lib|07h|       |    |       |        |R12
	 	 	 	8NF  |errcode|infoptr |
 	 	 	 	;
 	 	 	 	; Error codes:
 	 	 	 	;   00h. no error	 	CF = 0
 	 	 	 	;   01h: bad function	 	CF = 1
 	 	 	 	;   02h: shift overflow	 	CF = 1
 	 	 	 	;   03h: address overflow	CF = 1
 	 	 	 	;   04h: file open error	CF = 1
 	 	 	 	;   05h: file read error	CF = 1
 	 	 	 	;   06h: file close error	CF = 1
 	 	 	 	;   07h: sector read error	CF = 1
 	 	 	 	;
 	 	 	 	; Preserves: CX, SI, DI
 	 	 	 	
 0000	 	 	 	R128	PROC	NEAR
 0000  51	 	 	 	PUSH	CX	 	; save input CX
	 	 	 	 for caller
 0001  56	 	 	 	PUSH	SI	 	; save input SI
	 	 	 	 for caller
 0002  57	 	 	 	PUSH	DI	 	; save input DI
	 	 	 	 for caller
 	 	 	 	
 0003  89 1E 003D R	 	 	MOV	INP_BX, BX	; save input BX
	 	 	 	 for selected routine 
 0007  88 0E 003F R	 	 	MOV	INP_CL, CL	; save input CL
	 	 	 	 for selected routine
 000B  89 16 0040 R	 	 	MOV	INP_DX, DX	; save input DX
	 	 	 	 for selected routine
 	 	 	 	
 000F  3C 08	 	 	 	CMP	AL, RNUM	; compare funct
	 	 	 	ion code with max valid index
 0011  73 19	 	 	 	JAE	MNBADF	 	; if A >= RNUM:
	 	 	 	 invalid function, jump to MNBADF
 	 	 	 	
 0013  98	 	 	 	CBW	 	 	; AX = AL
 0014  D1 E0	 	 	 	SHL	AX, 1	 	; AX = AX * 2 (
	 	 	 	word index into jump table)
 0016  8B F0	 	 	 	MOV	SI, AX	 	; SI = AX
 0018  FF A4 001C R	 	 	JMP	WORD PTR MNJTAB[SI] ; indirect 
	 	 	 	jump to selected routine
 	 	 	 	
 001C  0035 R	 	 	MNJTAB	DW	R128IN	 	; 0: initialise
	 	 	 	 module
 001E  0036 R	 	 	 	DW	R128FF	 	; 1: find first
