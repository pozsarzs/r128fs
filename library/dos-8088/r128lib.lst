 	 	 	 	TITLE	R128 - filesystem handler routines for 
	 	 	 	DOS
 	 	 	 	NAME	R128
 	 	 	 	
 	 	 	 	; **** CONSTANTS ****
 = 0021	 	 	 	DOS	EQU	21h	 	; DOS functions
 = 0008	 	 	 	RNUM	EQU	08h	 	; number of rou
	 	 	 	tines
 	 	 	 	
 	 	 	 	; **** CODE AREA ****
 0000	 	 	 	CSEG	SEGMENT PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 	 	 	 	
 	 	 	 	EXTRN	RDSC:NEAR
 	 	 	 	EXTRN	RIMG:NEAR
 	 	 	 	EXTRN	RMEM:NEAR
 	 	 	 	
 	 	 	 	PUBLIC  R128
 	 	 	 	
 	 	 	 	; ---- ENTRY POINT AND JUMP TABLE -------------
	 	 	 	-----------------------
 	 	 	 	
 	 	 	 	;|name   |AL |BX     |CH  |CL     |DX      |fun
	 	 	 	ction|ret. AL|ret. BX |
 	 	 	 	;|-------|:-:|:-----:|:--:|:-----:|:------:|---
	 	 	 	-----|:-----:|:------:|
 	 	 	 	;|r128lib|00h|bufaddr|    |discid |        |R12
	 	 	 	8IN  |errcode|bufaddr |
 	 	 	 	;|r128lib|01h|       |    |       |maskaddr|R12
	 	 	 	8FF  |errcode|entryptr|
 	 	 	 	;|r128lib|02h|       |    |       |        |R12
