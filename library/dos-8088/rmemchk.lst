 0116  E8 0000 E	 	 	CALL	RMEM
 0119  0A C0	 	 	 	OR	AL, AL
 011B  75 12	 	 	 	JNZ	READER
 	 	 	 	
 	 	 	 	; print buffer
 011D  BA 0164 R	 	 	MOV	DX, OFFSET BUFFER
 0120  B4 09	 	 	 	MOV	AH, DPRINT
 0122  CD 21	 	 	 	INT	DOS
