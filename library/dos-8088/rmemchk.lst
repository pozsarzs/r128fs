 0136  B0 01	 	 	 	MOV	AL, 1	 	; error code = 
	 	 	 	1
 	 	 	 	
 0138  B4 4C	 	 	EXIT:	MOV	AH, DEXIT	; exit to DOS
 013A  CD 21	 	 	 	INT	DOS
 	 	 	 	
