 = 0021	 	 	 	DOS	EQU	21H	 	; BDOS function
	 	 	 	s
 = 0009	 	 	 	DPRINT	EQU	09H	 	; write string 
	 	 	 	to console function
 = 004C	 	 	 	DEXIT	EQU	4CH	 	; exit to DOS f
	 	 	 	unction
 = 0000	 	 	 	RMINIT	EQU	00H	 	; Rmemlib initi
	 	 	 	alize function
 = 0001	 	 	 	RMSTRD	EQU	01H	 	; Rmemlib secto
	 	 	 	r read function
 	 	 	 	
 0000	 	 	 	CSEG	SEGMENT	PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 0100	 	 	 	 	ORG	100H
 	 	 	 	
 	 	 	 	EXTRN	RMEM:NEAR
 	 	 	 	
 0100  0E	 	 	START:	PUSH	CS
 0101  1F	 	 	 	POP	DS
 	 	 	 	
 	 	 	 	; initialization
 0102  B0 00	 	 	 	MOV	AL, RMINIT
 0104  BB 0164 R	 	 	MOV	BX, OFFSET BUFFER
 0107  BA 013C R	 	 	MOV	DX, OFFSET ROMIMG
 010A  E8 0000 E	 	 	CALL	RMEM
 010D  0A C0	 	 	 	OR	AL, AL
 010F  75 18	 	 	 	JNZ	INITER
 	 	 	 	
 	 	 	 	; read sector 0
 0111  B0 01	 	 	 	MOV	AL, RMSTRD
