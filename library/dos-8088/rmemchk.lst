 0113  BA 0000	 	 	 	MOV	DX, 0000H
 0116  E8 0000 E	 	 	CALL	RMEM
 0119  0A C0	 	 	 	OR	AL, AL
 011B  75 10	 	 	 	JNZ	READER
 	 	 	 	
 	 	 	 	; print buffer
 011D  BA 0161 R	 	 	MOV	DX, OFFSET BUFFER
 0120  B4 09	 	 	 	MOV	AH, PRINTSTR
 0122  CD 21	 	 	 	INT	DOS
 0124  EB 0E 90	 	 	 	JMP	EXIT
 	 	 	 	
 	 	 	 	; handling error
 0127  BA 014B R	 	INITER:	MOV	DX, OFFSET MSGINI ; init error
 012A  EB 04 90	 	 	 	JMP	PRNER
 	 	 	 	
 012D  BA 0156 R	 	READER:	MOV	DX, OFFSET MSGRED ; read error
 	 	 	 	
 0130  B4 09	 	 	PRNER:	MOV	AH, PRINTSTR	; print error m
	 	 	 	essage
 0132  CD 21	 	 	 	INT	DOS
 	 	 	 	
 0134  B8 4C00	 	 	EXIT:	MOV	AX, 4C00H	; exit to DOS
 0137  CD 21	 	 	 	INT	DOS
 	 	 	 	
 	 	 	 	; -------- DATA AREA --------
 0139  52 4D 45 4D 4C 49	ROMIMG	DB	'RMEMLIB TEST OK', 13, 10, '$'
