       52 52 4F 52 24	 	
 0156  52 45 41 44 20 45	MSGRED	DB	'READ ERROR$'
       52 52 4F 52 24	 	
 0161     80 [	 	 	BUFFER	DB	128 DUP (?)
                ??	 	
                    ]	 	
 	 	 	 	
 	 	 	 	
