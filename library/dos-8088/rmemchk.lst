	 	 	 	0
 0126  EB 10 90	 	 	 	JMP	EXIT
 	 	 	 	
 	 	 	 	; handling error
 0129  BA 014E R	 	INITER:	MOV	DX, OFFSET MSGINI ; init error
 012C  EB 04 90	 	 	 	JMP	PRNER
 	 	 	 	
 012F  BA 0159 R	 	READER:	MOV	DX, OFFSET MSGRED ; read error
 	 	 	 	
 0132  B4 09	 	 	PRNER:	MOV	AH, DPRINT	; print error m
	 	 	 	essage
