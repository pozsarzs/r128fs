 	 	 	 	TITLE	RIMG - handler routines for in-image fi
	 	 	 	lesystem for DOS
 	 	 	 	NAME	RIMG
 	 	 	 	
 	 	 	 	; **** CONSTANTS ****
 = 0021	 	 	 	DOS	EQU	21h	 	; DOS functions
 = 001A	 	 	 	DSETDMA	EQU	1Ah	 	; - set DMA add
	 	 	 	ress
 = 000F	 	 	 	DOPEN	EQU	0Fh	 	; - open file
 = 0010	 	 	 	DCLOSE	EQU	10h	 	; - close file
 = 0021	 	 	 	DRDRND	EQU	21h	 	; - read random
 = 0003	 	 	 	RNUM	EQU	03h	 	; number of rou
	 	 	 	tines
 = 0080	 	 	 	SECT	EQU	0080h	 	; logical secto
	 	 	 	r size
 	 	 	 	
 	 	 	 	; **** CODE AREA ****
 0000	 	 	 	CSEG	SEGMENT PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 	 	 	 	
 	 	 	 	PUBLIC  RIMG
 	 	 	 	
