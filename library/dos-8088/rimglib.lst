 	 	 	 	;|rimglib|01h|       |    |       |sectnum |RIS
	 	 	 	TRD  |errcode|bufaddr |
 	 	 	 	;|rimglib|02h|       |    |onlyfcl|        |RID
	 	 	 	ONE  |errcode|        |
 	 	 	 	;
 	 	 	 	; Error codes:
 	 	 	 	;   00h. no error	 	CF = 0
 	 	 	 	;   01h: bad function	 	CF = 1
 	 	 	 	;   04h: file open error	CF = 1
 	 	 	 	;   05h: file read error	CF = 1
 	 	 	 	;   06h: file close error	CF = 1
 	 	 	 	;
 	 	 	 	; Preserves: CX, SI, DI
 	 	 	 	
 0000	 	 	 	RIMG	PROC	NEAR
 0000  51	 	 	 	PUSH	CX	 	; save input CX
	 	 	 	 for caller
 0001  56	 	 	 	PUSH	SI	 	; save input SI
	 	 	 	 for caller
 0002  57	 	 	 	PUSH	DI	 	; save input DI
	 	 	 	 for caller
 	 	 	 	
 0003  89 1E 00BE R	 	 	MOV	INP_BX, BX	; save input BX
	 	 	 	 for selected routine 
 0007  88 0E 00C0 R	 	 	MOV	INP_CL, CL	; save input CL
	 	 	 	 for selected routine
 000B  89 16 00C1 R	 	 	MOV	INP_DX, DX	; save input DX
	 	 	 	 for selected routine
 	 	 	 	
 000F  3C 03	 	 	 	CMP	AL, RNUM	; compare funct
	 	 	 	ion code with max valid index
 0011  73 0F	 	 	 	JAE	MNBADF	 	; if A >= RNUM:
	 	 	 	 invalid function, jump to MNBADF
 	 	 	 	
 0013  98	 	 	 	CBW	 	 	; AX = AL
 0014  D1 E0	 	 	 	SHL	AX, 1	 	; AX = AX * 2 (
	 	 	 	word index into jump table)
 0016  8B F0	 	 	 	MOV	SI, AX	 	; SI = AX
 0018  FF A4 001C R	 	 	JMP	WORD PTR MNJTAB[SI] ; indirect 
	 	 	 	jump to selected routine
 	 	 	 	
 001C  002B R	 	 	MNJTAB	DW	RIINIT	 	; 0: initialise
	 	 	 	 module
 001E  0064 R	 	 	 	DW	RISTRD	 	; 1: read a log
	 	 	 	ical sector and write to buffer
 0020  0096 R	 	 	 	DW	RIDONE	 	; 2: clean up a
	 	 	 	nd/or close image file
 	 	 	 	
 0022  5F	 	 	MNBADF:	POP	DI	 	; restore input
	 	 	 	 DI for caller
 0023  5E	 	 	 	POP	SI	 	; restore input
	 	 	 	 SI for caller
 0024  59	 	 	 	POP	CX	 	; restore input
	 	 	 	 CX for caller
