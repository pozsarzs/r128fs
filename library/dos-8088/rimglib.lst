 	 	 	 	TITLE	RIMG - R128 image sector read library f
	 	 	 	or DOS
 	 	 	 	NAME	RIMG
 	 	 	 	
 	 	 	 	; -------- CONSTANTS --------
 = 0021	 	 	 	DOS	EQU	21h	 	; DOS functions
 = 001A	 	 	 	DSETDMA	EQU	1Ah	 	; DOS set DMA a
	 	 	 	ddress function
 = 000F	 	 	 	DOPEN	EQU	0Fh	 	; DOS open file
	 	 	 	 function
 = 0010	 	 	 	DCLOSE	EQU	10h	 	; DOS close fil
	 	 	 	e function
 = 0021	 	 	 	DRDRND	EQU	21h	 	; DOS read rand
	 	 	 	om function
 = 0003	 	 	 	RNUM	EQU	03h	 	; number of rou
	 	 	 	tines
 = 0080	 	 	 	SECT	EQU	0080h	 	; logical secto
	 	 	 	r size
 	 	 	 	
 0000	 	 	 	CSEG	SEGMENT PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 	 	 	 	
