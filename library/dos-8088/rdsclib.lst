 	 	 	 	TITLE	RDSC - handler routines for on-disc fil
	 	 	 	esystem for DOS
 	 	 	 	NAME	RDSC
 	 	 	 	
 	 	 	 	; **** CONSTANTS ****
 = 0013	 	 	 	BIOS13	EQU	13h	 	; BIOS disk han
	 	 	 	dler function
 = 0002	 	 	 	B13RDST	EQU	02h	 	; - read sector
 = 0002	 	 	 	RNUM	EQU	02h	 	; number of rou
	 	 	 	tines
 	 	 	 	
 	 	 	 	; **** CODE AREA ****
 0000	 	 	 	CSEG	SEGMENT PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 	 	 	 	
 	 	 	 	PUBLIC  RDSC
 	 	 	 	
 	 	 	 	; ---- ENTRY POINT AND JUMP TABLE -------------
	 	 	 	-----------------------
 	 	 	 	
 	 	 	 	;|name   |AL |BX     |CH  |CL     |DX      |fun
	 	 	 	ction|ret. AL|ret. BX |
 	 	 	 	;|-------|:-:|:-----:|:--:|:-----:|:------:|---
	 	 	 	-----|:-----:|:------:|
 	 	 	 	;|rdsclib|00h|bufaddr|    |       |        |RDI
	 	 	 	NIT  |0      |bufaddr |
 	 	 	 	;|rdsclib|01h|sector |head|discid |track   |RDS
	 	 	 	TRD  |errcode|bufaddr |
 	 	 	 	;
 	 	 	 	; Error codes:
 	 	 	 	;   00h. no error	 	CF = 0
