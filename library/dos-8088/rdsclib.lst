 	 	 	 	;   01h: bad function	 	CF = 1
 	 	 	 	;   07h: sector read error	CF = 1
 	 	 	 	;
 	 	 	 	; Preserves: CX, SI, DI
 	 	 	 	
 0000	 	 	 	RDSC	PROC	NEAR
 0000  51	 	 	 	PUSH	CX	 	; save input CX
	 	 	 	 for caller
 0001  56	 	 	 	PUSH	SI	 	; save input SI
	 	 	 	 for caller
 0002  57	 	 	 	PUSH	DI	 	; save input DI
	 	 	 	 for caller
 	 	 	 	
 0003  89 1E 006A R	 	 	MOV	INPRBX, BX	; save input BX
	 	 	 	 for selected routine 
 0007  88 2E 006C R	 	 	MOV	INPRCH, CH	; save input CL
	 	 	 	 for selected routine
 000B  88 0E 006D R	 	 	MOV	INPRCL, CL	; save input CL
	 	 	 	 for selected routine
 000F  89 16 006E R	 	 	MOV	INPRDX, DX	; save input DX
	 	 	 	 for selected routine
 	 	 	 	
 0013  3C 02	 	 	 	CMP	AL, RNUM	; compare funct
	 	 	 	ion code with max valid index
 0015  73 0D	 	 	 	JAE	MNBADF	 	; if A >= RNUM:
	 	 	 	 invalid function, jump to MNBADF
 	 	 	 	
 0017  98	 	 	 	CBW	 	 	; AX = AL
 0018  D1 E0	 	 	 	SHL	AX, 1	 	; AX = AX * 2 (
	 	 	 	word index into jump table)
 001A  8B F0	 	 	 	MOV	SI, AX	 	; SI = AX
 001C  FF A4 0020 R	 	 	JMP	WORD PTR MNJTAB[SI] ; indirect 
	 	 	 	jump to selected routine
 	 	 	 	
 0020  002D R	 	 	MNJTAB	DW	RDINIT	 	; 0: initialise
	 	 	 	 module
 0022  003F R	 	 	 	DW	RDSTRD	 	; 1: read a log
	 	 	 	ical sector and write to buffer
 	 	 	 	
 0024  5F	 	 	MNBADF:	POP	DI	 	; restore input
	 	 	 	 DI for caller
 0025  5E	 	 	 	POP	SI	 	; restore input
	 	 	 	 SI for caller
 0026  59	 	 	 	POP	CX	 	; restore input
	 	 	 	 CX for caller
 0027  B0 01	 	 	 	MOV	AL, 01h	 	; AL = 1 (error
	 	 	 	: bad function)
 0029  33 DB	 	 	 	XOR	BX, BX	 	; BX = 0
 002B  F9	 	 	 	STC	 	 	; CF = 1 (retur
	 	 	 	n with error)
 002C  C3	 	 	 	RET
 	 	 	 	
