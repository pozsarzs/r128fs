 0000	 	 	 	RMEM	PROC	NEAR
 0000  51	 	 	 	PUSH	CX	 	; save input CX
	 	 	 	 for caller
 0001  56	 	 	 	PUSH	SI	 	; save input SI
	 	 	 	 for caller
 0002  57	 	 	 	PUSH	DI	 	; save input DI
	 	 	 	 for caller
 	 	 	 	
 0003  89 1E 006F R	 	 	MOV	INP_BX, BX	; save input BX
	 	 	 	 for selected routine 
 0007  89 16 0071 R	 	 	MOV	INP_DX, DX	; save input DX
	 	 	 	 for selected routine
 	 	 	 	
 000B  3C 02	 	 	 	CMP	AL, RNUM	; compare funct
	 	 	 	ion code with max valid index
 000D  73 0D	 	 	 	JAE	MNBADF	 	; if A >= RNUM:
	 	 	 	 invalid function, jump to MNBADF
 	 	 	 	
 000F  98	 	 	 	CBW	 	 	; AX = AL
 0010  D1 E0	 	 	 	SHL	AX, 1	 	; AX = AX * 2 (
	 	 	 	word index into jump table)
 0012  8B F0	 	 	 	MOV	SI, AX	 	; SI = AX
 0014  FF A4 0018 R	 	 	JMP	WORD PTR MNJTAB[SI] ; indirect 
	 	 	 	jump to selected routine
 	 	 	 	
 0018  0025 R	 	 	MNJTAB	DW	RMINIT	 	; 0: initialise
	 	 	 	 module
 001A  003C R	 	 	 	DW	RMSTRD	 	; 1: read a log
	 	 	 	ical sector and write to buffer
 	 	 	 	
 001C  5F	 	 	MNBADF:	POP	DI	 	; restore input
	 	 	 	 DI for caller
 001D  5E	 	 	 	POP	SI	 	; restore input
	 	 	 	 SI for caller
 001E  59	 	 	 	POP	CX	 	; restore input
	 	 	 	 DX for caller
 001F  B0 01	 	 	 	MOV	AL, 01h	 	; A = 1 (error:
	 	 	 	 bad function)
 0021  33 DB	 	 	 	XOR	BX, BX	 	; BX = 0
 0023  F9	 	 	 	STC	 	 	; CF = 1 (retur
	 	 	 	n with error)
 0024  C3	 	 	 	RET
 	 	 	 	
