	 	 	 	ffer
 012C  CD 21	 	 	 	INT	DOS	 	; call DOS
 012E  B0 00	 	 	 	MOV	AL, 0	 	; error code = 
	 	 	 	0
 0130  EB 10 90	 	 	 	JMP	EXIT	 	; goto EXIT
 	 	 	 	
 0133  BA 014C R	 	INITER:	MOV	DX, OFFSET MSGINI ; init error
