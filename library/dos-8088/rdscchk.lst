 	 	 	 	; **** CONSTANTS ****
 = 0021	 	 	 	DOS	EQU	21H	 	; DOS functions
 = 0009	 	 	 	DPRINT	EQU	09H	 	; - write strin
	 	 	 	g to console
 = 004C	 	 	 	DEXIT	EQU	4CH	 	; - exit to DOS
 = 0000	 	 	 	RDINIT	EQU	00H	 	; Rdsclib initi
	 	 	 	alize
 = 0001	 	 	 	RDSTRD	EQU	01H	 	; Rdsclib secto
	 	 	 	r read
 	 	 	 	
 	 	 	 	; **** CODE AREA ****
 0000	 	 	 	CSEG	SEGMENT	PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 0100	 	 	 	 	ORG	100H
 	 	 	 	
 	 	 	 	EXTRN	RDSC:NEAR
 	 	 	 	
 0100  0E	 	 	START:	PUSH	CS
 0101  1F	 	 	 	POP	DS	 	; DS = CS
 	 	 	 	
 0102  B0 00	 	 	 	MOV	AL, RDINIT	; AL = initiali
	 	 	 	zation
 0104  BB 0164 R	 	 	MOV	BX, OFFSET BUFFER ; BX = buffer
	 	 	 	 address
 0107  E8 0000 E	 	 	CALL	RDSC	 	; call RDSC
 010A  0A C0	 	 	 	OR	AL, AL
 010C  75 25	 	 	 	JNZ	INITER	 	; detect init e
	 	 	 	rror
 	 	 	 	
 010E  B0 01	 	 	 	MOV	AL, RDSTRD	; AL = read sec
	 	 	 	tor
