 	 	 	 	; read sector 0
 0113  B0 01	 	 	 	MOV	AL, RISTRD
 0115  8B 16 0139 R	 	 	MOV	DX, RECNUM
 0119  E8 0000 E	 	 	CALL	RIMG
 011C  0A C0	 	 	 	OR	AL, AL
 011E  75 0C	 	 	 	JNZ	ERROR
 	 	 	 	
 	 	 	 	; print buffer
 0120  BA 016C R	 	 	MOV	DX, OFFSET BUFFER
 0123  B4 09	 	 	 	MOV	AH, DPRINT
 0125  CD 21	 	 	 	INT	DOS
 0127  B0 00	 	 	 	MOV	AL, 0	 	; error code = 
	 	 	 	0
 0129  EB 0A 90	 	 	 	JMP	EXIT
 	 	 	 	
 	 	 	 	; handling error
 012C  BA 013B R	 	ERROR:	MOV	DX, OFFSET ERRMSG ; error messa
	 	 	 	ge
 012F  B4 09	 	 	 	MOV	AH, DPRINT	; print error m
	 	 	 	essage
 0131  CD 21	 	 	 	INT	DOS
 0133  B0 01	 	 	 	MOV	AL, 1	 	; error code = 
	 	 	 	1
 	 	 	 	
 0135  B4 4C	 	 	EXIT:	MOV	AH, DEXIT	; exit to DOS
 0137  CD 21	 	 	 	INT	DOS
 	 	 	 	
 	 	 	 	; -------- DATA AREA --------
 0139  0001	 	 	RECNUM 	DW	0001h	 	; logical 128-b
	 	 	 	yte record number
 013B  52 65 61 64 20 65	ERRMSG 	DB	'Read error!$'
       72 72 6F 72 21 24	
 0147  00	 	 	FCB 	DB	0	 	; drive
 0148  52 31 32 38 45 58	 	DB	'R128EXRMIMG'	; 8.3 filename
       52 4D 49 4D 47	 	
 0153     19 [	 	 	 	DB	25 DUP (?)
                ??	 	
                    ]	 	
 	 	 	 	
 016C     80 [	 	 	BUFFER	DB	128 DUP (?), '$'
