 = 0021	 	 	 	DOS	EQU	21H	 	; DOS functions
 = 0009	 	 	 	DPRINT	EQU	09H	 	; write string 
	 	 	 	to console function
 = 004C	 	 	 	DEXIT	EQU	4CH	 	; exit to DOS f
	 	 	 	unction
 = 0000	 	 	 	RIINIT	EQU	00H	 	; Rimglib initi
	 	 	 	alize function
 = 0001	 	 	 	RISTRD	EQU	01H	 	; Rimglib secto
	 	 	 	r read function
 = 0002	 	 	 	RIDONE	EQU	02H	 	; Rimglib done 
	 	 	 	function
 	 	 	 	
 0000	 	 	 	CSEG	SEGMENT	PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 0100	 	 	 	 	ORG	100H
 	 	 	 	
 	 	 	 	EXTRN	RIMG:NEAR
 	 	 	 	
 0100  0E	 	 	START:	PUSH	CS
 0101  1F	 	 	 	POP	DS
 	 	 	 	
 	 	 	 	; initialization
 0102  B0 00	 	 	 	MOV	AL, RIINIT
 0104  B1 00	 	 	 	MOV	CL, 0
 0106  BB 016C R	 	 	MOV	BX, OFFSET BUFFER
 0109  BA 0147 R	 	 	MOV	DX, OFFSET FCB
 010C  E8 0000 E	 	 	CALL	RIMG
 010F  0A C0	 	 	 	OR	AL, AL
 0111  75 19	 	 	 	JNZ	ERROR
 	 	 	 	
 Microsoft MACRO Assembler  Version 3.00               	Page	1-2
