 = 0021	 	 	 	DOS	EQU	21H	 	; DOS functions
 = 0009	 	 	 	DPRINT	EQU	09H	 	; - write strin
	 	 	 	g to console
 = 004C	 	 	 	DEXIT	EQU	4CH	 	; - exit to DOS
 = 0000	 	 	 	RIINIT	EQU	00H	 	; Rimglib initi
	 	 	 	alize function
 = 0001	 	 	 	RISTRD	EQU	01H	 	; Rimglib secto
	 	 	 	r read function
 = 0002	 	 	 	RIDONE	EQU	02H	 	; Rimglib done 
	 	 	 	function
 	 	 	 	
 	 	 	 	; **** CODE AREA ****
 0000	 	 	 	CSEG	SEGMENT	PUBLIC 'CODE'
 	 	 	 	 	ASSUME	CS:CSEG, DS:CSEG, ES:CSEG, SS:C
	 	 	 	SEG
 0100	 	 	 	 	ORG	100H
 	 	 	 	
 	 	 	 	EXTRN	RIMG:NEAR
 	 	 	 	
 0100  0E	 	 	START:	PUSH	CS
 0101  1F	 	 	 	POP	DS	 	; DS = CS
 	 	 	 	
 0102  B0 00	 	 	 	MOV	AL, RIINIT	; AL = initiali
	 	 	 	zation
 0104  B1 00	 	 	 	MOV	CL, 0	 	; CL = mode
 0106  BB 017E R	 	 	MOV	BX, OFFSET BUFFER ; BX = buffer
	 	 	 	 address
 0109  BA 0159 R	 	 	MOV	DX, OFFSET FCB	; DX = FCB addr
	 	 	 	ess
 010C  E8 0000 E	 	 	CALL	RIMG	 	; call RIMG
 010F  0A C0	 	 	 	OR	AL, AL
