                ; terms of the MIT License.
                ;
                ; This program is distributed in the hope that it will be useful, but WITHOUT
                ; ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
                ; FOR A PARTICULAR PURPOSE.
                
 0100           	ORG	100h
                	EXTRN	RMEM
                
                ; -------- CONSTANTS --------
 0005 =         BDOS	EQU	0005h		; BDOS entry point
 0000 =         RESET	EQU	00h		; BDOS system reset function
 0009 =         PRINT	EQU	09h		; BDOS print string function
 0000 =         RMINIT	EQU	00h		; Rmemlib initialize function
 0001 =         RMSTRD	EQU	01h		; Rmemlib sector read function
                
                ; -------- CODE AREA --------
                ; initialize
 0100 3E00      START:	MVI	A, RMINIT
 0102 113701    	LXI	D, ROMIMG
 0105 216101    	LXI	H, BUFFER
 0108 CD0000    	CALL	RMEM
 010B DA2401    	JC	INITER
                
                ; read sector 0
 010E 3E01      	MVI	A, RMSTRD
 0110 110000    	LXI	D, 0000h
 0113 CD0000    	CALL	RMEM
 0116 DA2A01    	JC	READER
                
                ; print buffer
 0119 116101    	LXI	D, BUFFER
 011C 0E09      	MVI	C, PRINT
 011E CD0500    	CALL	BDOS
 0121 C33201    	JMP	EXIT
                
                ; handling error
 0124 114901    INITER:	LXI	D, MSGINI	; init error
 0127 C32D01    	JMP	PRNER
                
 012A 115501    READER:	LXI	D, MSGRED	; read error
                
 012D 0E09      PRNER:	MVI	C, PRINT	; print error message
 012F CD0500    	CALL	BDOS
                
 0132 0E00      EXIT:	MVI	C, RESET	; exit to BDOS
 0134 CD0500    	CALL	BDOS
                
                ; -------- DATA AREA --------
 0137 524D454D4CROMIMG:	DB	'RMEMLIB TEST OK',13,10,'$'
 0149 494E495420MSGINI:	DB	'INIT ERROR$', 0
 0155 5245414420MSGRED:	DB	'READ ERROR$', 0
 0161           BUFFER:	DS	128
 01E1           	END	START
