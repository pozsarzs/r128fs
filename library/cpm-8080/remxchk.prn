 0100           	ORG	100h
                	EXTRN	REMX
                
                ; **** CONSTANTS ****
 0005 =         BDOS	EQU	05h		; BDOS entry point
 0000 =         REINIT	EQU	00h		; Remxlib initialize function
 0001 =         RESTRD	EQU	01h		; Remxlib sector read function
                
                ; **** CODE AREA *****
                START:
                ; initialization and open
                
                ; read record
                
                ; dump buffer to console
                
                ; handling error
                
 0100 C9        	RET
                ; **** DATA AREA ****
 0101           BUFFER:	DS	128
 0181           	END
